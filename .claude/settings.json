{
  "effortLevel": "high",
  "autoCompactWindow": 300000,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CARGO_TERM_QUIET": "true",
    "CARGO_TERM_COLOR": "never",
    "CARGO_TERM_PROGRESS_WHEN": "never",
    "RUST_BACKTRACE": "1"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "jdtls-lsp@claude-plugins-official": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/sync", "timeout": 120 },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/gate --init" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "rust-reviewer|ui-auditor|ux-tester|perf-tester",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/gate --mark" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/bin/gate --hook || { echo 'The gate could not run, so nothing was checked. Fix .claude/bin/gate, then stop again.' >&2; exit 2; }",
            "timeout": 590,
            "statusMessage": "Quality gate"
          }
        ]
      }
    ]
  }
}
