#!/bin/bash
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
ROOT=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  new)
    name="${1:?name}"; shift
    model=sonnet
    if [ "${1:-}" = "--model" ]; then model="$2"; shift 2; fi
    task="${1:?task}"
    wt="$ROOT/.claude/worktrees/$name"
    git -C "$ROOT" worktree add -q -b "herd/$name" "$wt" HEAD || exit 1
    grep -qx '/.cargo/' "$ROOT/.git/info/exclude" || echo '/.cargo/' >> "$ROOT/.git/info/exclude"
    mkdir -p "$wt/.cargo"
    printf '[patch.crates-io]\ngpui-component = { path = "%s/vendor/gpui-component" }\n' "$ROOT" > "$wt/.cargo/config.toml"
    reach="${HC_TERMINAL_ID:-}"
    prompt="You work alone in the git worktree $wt on branch herd/$name. Only touch this worktree. Follow the ship skill and commit here at stable points; never push or merge. Do not start other hc agents. Helpers share one build cache, so cargo may wait for another helper's build; that is normal, do not cancel it. Do not edit vendor/. Task: $task"
    [ -n "$reach" ] && prompt="$prompt Report the result or any blocker with: hc send $reach \"<text>\""
    hc run --bg --json --name "$name" --cwd "$wt" --label herd=1 -- env RUSTC_WRAPPER=sccache CARGO_BUILD_BUILD_DIR="$ROOT/target/herd" claude --model "$model" --permission-mode "${HERD_MODE:-auto}" "$prompt" | jq -c '{address, name}'
    for _ in $(seq 1 30); do
      screen=$(hc read --lines 30 "$name" 2>/dev/null)
      case "$screen" in
        *"trust this folder"*) hc keys "$name" down enter >/dev/null; break ;;
        *"$name"*"Task:"*) break ;;
      esac
      perl -e 'select(undef,undef,undef,0.5)'
    done
    ;;
  ls)
    git -C "$ROOT" worktree list | grep 'herd/' || echo "no helpers"
    ;;
  rm)
    name="${1:?name}"
    wt="$ROOT/.claude/worktrees/$name"
    hc kill "$name" >/dev/null 2>&1
    git -C "$ROOT" worktree remove "$wt" || exit 1
    git -C "$ROOT" branch -d "herd/$name"
    ;;
  *)
    echo "herd new <name> [--model m] <task> | herd ls | herd rm <name>"
    ;;
esac
