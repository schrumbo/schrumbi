#!/bin/bash
set -u
ROOT=$(git rev-parse --show-toplevel) || exit 1
COMMON=$(cd "$ROOT" && cd "$(git rev-parse --git-common-dir)" && pwd)
GUI="$COMMON/agent-tools/gui"
WORK="${TMPDIR:-/tmp}/schrumbi-agent/$(printf '%s' "$ROOT" | shasum | cut -c1-10)"
PIDFILE="$WORK/pid"

gui_tool() {
  if [ ! -x "$GUI" ] || [ "$ROOT/.claude/tools/gui.swift" -nt "$GUI" ]; then
    mkdir -p "$(dirname "$GUI")"
    swiftc -O "$ROOT/.claude/tools/gui.swift" -o "$GUI" || exit 1
  fi
}

pid() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null || { echo "app is not running; use: app start" >&2; exit 1; }
  cat "$PIDFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
  fi
}

shot() {
  local p id out
  p=$(pid) || exit 1
  id=$("$GUI" list "$p" | head -1 | cut -d' ' -f1)
  [ -n "$id" ] || { echo "no window for pid $p" >&2; exit 1; }
  out="$WORK/shots/$1.png"
  mkdir -p "$WORK/shots"
  screencapture -x -o -l "$id" "$out" || exit 1
  sips -Z 1500 "$out" >/dev/null
  echo "$out"
}

gui_tool
cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start)
    profile=perf; extra=(); notes=60
    while [ $# -gt 0 ]; do
      case "$1" in
        --debug) profile=dev ;;
        --light) extra+=(-NSRequiresAquaSystemAppearance YES) ;;
        --notes) notes="$2"; shift ;;
      esac
      shift
    done
    stop
    (cd "$ROOT" && cargo build --profile "$profile") || exit 1
    dir=$profile; [ "$profile" = dev ] && dir=debug
    rm -rf "$WORK/home" "$WORK/data"
    mkdir -p "$WORK/home"
    python3 -I "$ROOT/.claude/tools/fixture.py" "$WORK/data" "$notes" || exit 1
    printf '{"mainWindow":[100,80,1360,860]}' > "$WORK/home/settings.json"
    : > "$WORK/log"
    SCHRUMBI_PERF=1 SCHRUMBI_HOME="$WORK/home" RUST_BACKTRACE=1 nohup "$ROOT/target/$dir/schrumbi" "$WORK/data" ${extra[@]+"${extra[@]}"} >> "$WORK/log" 2>&1 &
    echo $! > "$PIDFILE"
    for _ in $(seq 1 120); do
      [ -n "$("$GUI" list "$(cat "$PIDFILE")" | head -1)" ] && break
      kill -0 "$(cat "$PIDFILE")" 2>/dev/null || { echo "app exited:" >&2; tail -20 "$WORK/log" >&2; exit 1; }
      perl -e 'select(undef,undef,undef,0.25)'
    done
    echo "pid $(cat "$PIDFILE"), data $WORK/data, notes $notes, profile $profile"
    "$GUI" list "$(cat "$PIDFILE")" | head -1
    ;;
  perf)
    p=$(pid) || exit 1
    sub="${1:-}"; [ $# -gt 0 ] && shift
    case "$sub" in
      begin) wc -c < "$WORK/log" | tr -d ' ' > "$WORK/perf-from" ;;
      end)
        COMMIT=$(git -C "$ROOT" rev-parse --short HEAD) LOGFILE="$COMMON/agent-tools/perf.log" PID="$p" \
          python3 -I "$ROOT/.claude/tools/perf.py" "$WORK/log" "$(cat "$WORK/perf-from" 2>/dev/null || echo 0)" "${1:?scenario}"
        ;;
      idle)
        wc -c < "$WORK/log" | tr -d ' ' > "$WORK/perf-from"
        sleep "${1:-3}"
        COMMIT=$(git -C "$ROOT" rev-parse --short HEAD) LOGFILE="$COMMON/agent-tools/perf.log" PID="$p" \
          python3 -I "$ROOT/.claude/tools/perf.py" "$WORK/log" "$(cat "$WORK/perf-from")" idle
        ;;
      *) echo "app perf begin | end <scenario> | idle [seconds]" >&2; exit 1 ;;
    esac
    ;;
  stop) stop ;;
  shot) shot "${1:?name}" ;;
  hover)
    p=$(pid) || exit 1
    "$GUI" move "$p" "${1:?x}" "${2:?y}"
    perl -e 'select(undef,undef,undef,0.3)'
    shot "${3:?name}"
    ;;
  click|move|key|type|wheel|list)
    p=$(pid) || exit 1
    "$GUI" "$cmd" "$p" "$@"
    ;;
  log) tail -"${1:-40}" "$WORK/log" ;;
  *)
    cat <<'EOF'
app start [--debug] [--light] [--notes N]
                                  build (perf profile), fresh scratch data, one window
app perf begin                    start measuring; then drive the app
app perf end <scenario>           frames, p50, p95, max, over budget, CPU, memory, last result
app perf idle [seconds]           an idle app should draw no frames
app stop                          close only the instance started here
app shot <name>                   screenshot, prints the path
app hover <x> <y> <name>          move the pointer, wait, screenshot
app click <x> <y> [n] [right] [cmd|shift|alt|ctrl]
app move <x> <y>
app key <keycode> [cmd+shift]     QWERTZ: keycode 16 is Z, 6 is Y; 36 Enter, 48 Tab, 53 Esc
app type <text>
app wheel <x> <y> <steps> [mods]
app list                          window id x y w h title
app log [lines]
Coordinates are points inside the window. Input is refused unless the app is frontmost.
EOF
    ;;
esac
